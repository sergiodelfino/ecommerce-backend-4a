            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"usuario\": {\n    \"id\": \"{{idUsuario}}\"\n  },\n  \"viagem\": {\n    \"id\": \"{{idViagem}}\"\n  },\n  \"status\": \"CONFIRMADA\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 409\", function () { pm.response.to.have.status(409); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Registrar presença de teste",
