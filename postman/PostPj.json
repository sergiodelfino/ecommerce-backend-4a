{
  "info": {
    "name": "Tô Aqui! API",
    "description": "Valida os oito recursos centrais: cria dados temporários, percorre CRUD, verifica reserva duplicada e reativação após cancelamento, e remove os registros ao final. Use apenas em ambiente de desenvolvimento ou teste.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "basic",
    "basic": [
      {
        "key": "username",
        "value": "{{usuarioAuth}}",
        "type": "string"
      },
      {
        "key": "password",
        "value": "{{senhaAuth}}",
        "type": "string"
      }
    ]
  },
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (pm.info.requestName === \"Criar usuário de teste\" || !pm.collectionVariables.get(\"runId\")) {",
          "  const runId = pm.variables.replaceIn(\"{{$guid}}\").replace(/-/g, \"\").slice(0, 8).toUpperCase();",
          "  pm.collectionVariables.set(\"runId\", runId);",
          "  pm.collectionVariables.set(\"placaTeste\", \"TA\" + runId.slice(0, 5));",
          "}",
          "const partida = new Date(Date.now() + 24 * 60 * 60 * 1000);",
          "const dois = (n) => String(n).padStart(2, \"0\");",
          "pm.collectionVariables.set(\"partida\", partida.getFullYear() + \"-\" + dois(partida.getMonth()+1) + \"-\" + dois(partida.getDate()) + \"T\" + dois(partida.getHours()) + \":\" + dois(partida.getMinutes()) + \":\" + dois(partida.getSeconds()));"
        ]
      }
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "usuarioAuth",
      "value": ""
    },
    {
      "key": "senhaAuth",
      "value": ""
    },
    {
      "key": "runId",
      "value": ""
    },
    {
      "key": "placaTeste",
      "value": ""
    },
    {
      "key": "partida",
      "value": ""
    },
    {
      "key": "idUsuario",
      "value": ""
    },
    {
      "key": "idVeiculo",
      "value": ""
    },
    {
      "key": "idRota",
      "value": ""
    },
    {
      "key": "idViagem",
      "value": ""
    },
    {
      "key": "idParada",
      "value": ""
    },
    {
      "key": "idAviso",
      "value": ""
    },
    {
      "key": "idReserva",
      "value": ""
    },
    {
      "key": "idPresenca",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "01 - Criar dados de teste",
      "item": [
        {
          "name": "Criar usuário de teste",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/usuarios"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Aluno teste {{runId}}\",\n  \"email\": \"teste.{{runId}}@example.com\",\n  \"senha\": \"texto-de-teste\",\n  \"perfil\": \"ALUNO\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", function () { pm.response.to.have.status(201); });",
                  "pm.collectionVariables.set(\"idUsuario\", pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Criar veículo de teste",
